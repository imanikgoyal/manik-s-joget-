                  <pluginName>org.joget.apps.app.lib.MultiTools</pluginName>
                  <pluginProperties>{&quot;runInMultiThread&quot;:&quot;&quot;,&quot;comment&quot;:&quot;&quot;,&quot;tools&quot;:[{&quot;className&quot;:&quot;org.joget.apps.app.lib.BeanShellTool&quot;,&quot;properties&quot;:{&quot;script&quot;:&quot;import java.sql.Connection;\nimport java.sql.PreparedStatement;\nimport java.sql.ResultSet;\nimport javax.sql.DataSource;\n\nimport org.joget.apps.app.service.AppUtil;\nimport org.joget.commons.util.LogUtil;\n\n// Logger name\nString logName = \&quot;RowCountLogger\&quot;;\n\n// Get datasource\nDataSource ds = (DataSource) AppUtil.getApplicationContext().getBean(\&quot;setupDataSource\&quot;);\n\nConnection con = null;\nPreparedStatement stmt = null;\nResultSet rs = null;\n\nint count = 0;\n\ntry {\n    LogUtil.info(logName, \&quot;Starting row count query...\&quot;);\n\n    con = ds.getConnection();\n    LogUtil.info(logName, \&quot;Database connection established\&quot;);\n\n    String sql = \&quot;SELECT COUNT(*) AS total FROM your_table_name\&quot;;\n    LogUtil.info(logName, \&quot;Executing query: \&quot; + sql);\n\n    stmt = con.prepareStatement(sql);\n    rs = stmt.executeQuery();\n\n    if (rs.next()) {\n        count = rs.getInt(\&quot;total\&quot;);\n        LogUtil.info(logName, \&quot;Row count fetched: \&quot; + count);\n    } else {\n        LogUtil.warn(logName, \&quot;No result returned from query\&quot;);\n    }\n\n} catch (Exception e) {\n    LogUtil.error(logName, e, \&quot;Error while counting rows\&quot;);\n} finally {\n    try {\n        if (rs != null) {\n            rs.close();\n            LogUtil.info(logName, \&quot;ResultSet closed\&quot;);\n        }\n    } catch (Exception e) {\n        LogUtil.warn(logName, \&quot;Error closing ResultSet\&quot;);\n    }\n\n    try {\n        if (stmt != null) {\n            stmt.close();\n            LogUtil.info(logName, \&quot;Statement closed\&quot;);\n        }\n    } catch (Exception e) {\n        LogUtil.warn(logName, \&quot;Error closing Statement\&quot;);\n    }\n\n    try {\n        if (con != null) {\n            con.close();\n            LogUtil.info(logName, \&quot;Connection closed\&quot;);\n        }\n    } catch (Exception e) {\n        LogUtil.warn(logName, \&quot;Error closing Connection\&quot;);\n    }\n}\n\n// Final log\nLogUtil.info(logName, \&quot;Final Row Count: \&quot; + count);\n\n// return if needed\nreturn count;&quot;}}]}</pluginProperties>
